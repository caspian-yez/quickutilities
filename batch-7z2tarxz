#!/usr/bin/env sh
# SPDX-License-Identifier: MIT

basefilepath=$(pwd)
workspace="/tmp/7z2tarxz"

for i in *.7z; do
	mkdir -p "$workspace"
	rm -rfv $workspace/*
	timestamp="$(stat -c %y "$i")"
	# echo $i
	echo "extracting"
	7z x -o"$workspace" "$i"
	filename=$(basename -- "$i")
	# echo $filename
	filename="${filename%.*}"
	# echo $filename
	echo "compressing"
	cd "$workspace"
	batch-644-file
	batch-755-folder
	tar --owner=root --group=root -cvJf "$filename.tar.xz" *
	cd $basefilepath
	cp "$workspace/$filename.tar.xz" .
	touch -d "$timestamp" "$filename.tar.xz"
	tar -tvf "$filename.tar.xz"
done
